generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @db.Uuid
  fullName      String        @map("full_name")
  email         String        @unique
  passwordHash  String        @map("password_hash")
  phone         String?
  roleId        String        @map("role_id") @db.Uuid
  isActive      Boolean       @default(true) @map("is_active")
  twoFactorSecret String?     @map("two_factor_secret")
  lastLoginAt   DateTime?     @map("last_login_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  role          Role          @relation(fields: [roleId], references: [id])
  authSessions  AuthSession[]
  auditLogs     AuditLog[]
  stockMovementsCreated StockMovement[]

  @@map("users")
}

model Role {
  id              String           @id @db.Uuid
  name            String
  slug            String           @unique
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @db.Uuid
  name            String
  slug            String           @unique
  module          String
  description     String?
  rolePermissions RolePermission[]

  @@map("permissions")
}

model Variant {
  id             String          @id @db.Uuid
  productId      String?         @map("product_id") @db.Uuid
  sku            String          @unique
  name           String
  price          Decimal         @db.Decimal(12, 2)
  taxRate        Decimal         @default(0) @map("tax_rate") @db.Decimal(5, 2)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  product        Product?        @relation(fields: [productId], references: [id])
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  orderItems     OrderItem[]
  searchDocuments SearchDocument[]

  @@index([productId])
  @@map("variants")
}

model Brand {
  id          String    @id @db.Uuid
  name        String
  slug        String    @unique
  description String?
  metadata    Json?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@map("brands")
}

model Category {
  id          String     @id @db.Uuid
  parentId    String?    @map("parent_id") @db.Uuid
  name        String
  slug        String     @unique
  description String?
  isActive    Boolean    @default(true) @map("is_active")
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id          String    @id @db.Uuid
  brandId     String?   @map("brand_id") @db.Uuid
  categoryId  String?   @map("category_id") @db.Uuid
  name        String
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  brand       Brand?    @relation(fields: [brandId], references: [id])
  category    Category? @relation(fields: [categoryId], references: [id])
  variants    Variant[]
  promotions  Promotion[]

  @@index([brandId])
  @@index([categoryId])
  @@map("products")
}

model Warehouse {
  id             String          @id @db.Uuid
  name           String
  location       String?
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]

  @@map("warehouses")
}

model RolePermission {
  id           String     @id @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model AuthSession {
  id                String    @id @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  refreshTokenHash  String    @map("refresh_token_hash")
  tokenFamily       String    @map("token_family")
  currentJti        String    @map("current_jti")
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")
  createdAt         DateTime  @default(now()) @map("created_at")
  lastUsedAt        DateTime? @map("last_used_at")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  compromisedAt     DateTime? @map("compromised_at")
  user              User      @relation(fields: [userId], references: [id])

  @@index([userId, tokenFamily])
  @@map("auth_sessions")
}

model AuditLog {
  id          String   @id @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  requestId   String?  @map("request_id")
  correlationId String? @map("correlation_id")
  beforeData  Json?    @map("before_data")
  afterData   Json?    @map("after_data")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User?    @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Order {
  id                String         @id @db.Uuid
  orderNumber       String         @unique @map("order_number")
  status            OrderStatus
  customerName      String         @map("customer_name")
  customerEmail     String         @map("customer_email")
  customerPhone     String         @map("customer_phone")
  shippingAddress   String         @map("shipping_address")
  shippingCity      String         @map("shipping_city")
  shippingNotes     String?        @map("shipping_notes")
  subtotal          Decimal        @db.Decimal(12, 2)
  discountTotal     Decimal        @map("discount_total") @db.Decimal(12, 2)
  taxTotal          Decimal        @map("tax_total") @db.Decimal(12, 2)
  shippingTotal     Decimal        @map("shipping_total") @db.Decimal(12, 2)
  grandTotal        Decimal        @map("grand_total") @db.Decimal(12, 2)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  orderItems        OrderItem[]
  payments          Payment[]

  @@index([orderNumber])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                  String   @id @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  variantId           String   @map("variant_id") @db.Uuid
  warehouseId         String   @map("warehouse_id") @db.Uuid
  variantNameSnapshot String   @map("variant_name_snapshot")
  skuSnapshot         String   @map("sku_snapshot")
  unitPrice           Decimal  @map("unit_price") @db.Decimal(12, 2)
  taxRate             Decimal  @map("tax_rate") @db.Decimal(5, 2)
  quantity            Int
  lineDiscountTotal   Decimal  @default(0) @map("line_discount_total") @db.Decimal(12, 2)
  appliedPromotionIds Json?    @map("applied_promotion_ids")
  lineSubtotal        Decimal  @map("line_subtotal") @db.Decimal(12, 2)
  lineTaxTotal        Decimal  @map("line_tax_total") @db.Decimal(12, 2)
  lineGrandTotal      Decimal  @map("line_grand_total") @db.Decimal(12, 2)
  createdAt           DateTime @default(now()) @map("created_at")
  order               Order    @relation(fields: [orderId], references: [id])
  variant             Variant  @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id               String        @id @db.Uuid
  orderId          String        @map("order_id") @db.Uuid
  gateway          String
  gatewayReference String        @map("gateway_reference")
  transactionId    String?       @map("transaction_id")
  amount           Decimal       @db.Decimal(12, 2)
  currency         String
  status           PaymentStatus
  rawPayload       Json?         @map("raw_payload")
  confirmedAt      DateTime?     @map("confirmed_at")
  expiresAt        DateTime?     @map("expires_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  order            Order         @relation(fields: [orderId], references: [id])

  @@unique([gateway, gatewayReference])
  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model WebhookReceipt {
  id              String   @id @db.Uuid
  gateway         String
  externalEventId String   @map("external_event_id")
  signature       String?
  payload         Json     @map("payload")
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([gateway, externalEventId])
  @@map("webhook_receipts")
}

model InventoryItem {
  id          String      @id @db.Uuid
  variantId   String      @map("variant_id") @db.Uuid
  warehouseId String      @map("warehouse_id") @db.Uuid
  onHandQty   Int         @default(0) @map("on_hand_qty")
  reservedQty Int         @default(0) @map("reserved_qty")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  variant     Variant     @relation(fields: [variantId], references: [id])
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])

  @@unique([variantId, warehouseId])
  @@map("inventory_items")
}

model StockMovement {
  id            String            @id @db.Uuid
  movementType  StockMovementType @map("movement_type")
  variantId     String            @map("variant_id") @db.Uuid
  warehouseId   String            @map("warehouse_id") @db.Uuid
  quantity      Int
  referenceType String            @map("reference_type")
  referenceId   String            @map("reference_id")
  reason        String?
  createdByUserId String?         @map("created_by_user_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")
  variant       Variant           @relation(fields: [variantId], references: [id])
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id])
  createdByUser User?             @relation(fields: [createdByUserId], references: [id])

  @@unique([movementType, variantId, warehouseId, referenceType, referenceId])
  @@index([variantId, warehouseId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model Promotion {
  id            String                 @id @db.Uuid
  productId     String?                @map("product_id") @db.Uuid
  name          String
  slug          String                 @unique
  description   String?
  type          PromotionType
  scope         PromotionScope
  stackingMode  PromotionStackingMode  @map("stacking_mode")
  priority      Int                    @default(0)
  value         Decimal                @db.Decimal(12, 2)
  minSubtotal   Decimal?               @map("min_subtotal") @db.Decimal(12, 2)
  minQuantity   Int?                   @map("min_quantity")
  targetType    PromotionTargetType    @map("target_type")
  targetIds     Json?                  @map("target_ids")
  isActive      Boolean                @default(false) @map("is_active")
  startsAt      DateTime?              @map("starts_at")
  endsAt        DateTime?              @map("ends_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  product       Product?               @relation(fields: [productId], references: [id])

  @@index([isActive, startsAt, endsAt])
  @@map("promotions")
}

model ContentBlock {
  id           String       @id @db.Uuid
  title        String
  slug         String?      @unique
  type         ContentType
  placementKey String       @map("placement_key")
  body         Json
  isPublished  Boolean      @default(false) @map("is_published")
  startsAt     DateTime?    @map("starts_at")
  endsAt       DateTime?    @map("ends_at")
  priority     Int          @default(0)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  searchDocuments SearchDocument[]

  @@index([placementKey, isPublished, startsAt, endsAt, priority])
  @@map("content_blocks")
}

model Notification {
  id               String             @id @db.Uuid
  eventId          String             @map("event_id")
  eventName        String             @map("event_name")
  channel          NotificationChannel
  recipient        String
  subject          String?
  content          String
  provider         String
  status           NotificationStatus @default(queued)
  providerMessageId String?           @map("provider_message_id")
  attempts         Int                @default(0)
  lastError        String?            @map("last_error")
  payload          Json?
  sentAt           DateTime?          @map("sent_at")
  failedAt         DateTime?          @map("failed_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@unique([eventId, channel, recipient])
  @@index([eventName, status, createdAt])
  @@map("notifications")
}

model SearchDocument {
  id             String             @id @db.Uuid
  documentType   SearchDocumentType @map("document_type")
  variantId      String?            @map("variant_id") @db.Uuid
  contentBlockId String?            @map("content_block_id") @db.Uuid
  title          String
  subtitle       String?
  sku            String?
  brandName      String?            @map("brand_name")
  brandSlug      String?            @map("brand_slug")
  categoryName   String?            @map("category_name")
  categorySlug   String?            @map("category_slug")
  placementKey   String?            @map("placement_key")
  searchText     String             @map("search_text")
  isActive       Boolean            @default(true) @map("is_active")
  availability   Int                @default(0)
  priority       Int                @default(0)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  variant        Variant?           @relation(fields: [variantId], references: [id])
  contentBlock   ContentBlock?      @relation(fields: [contentBlockId], references: [id])

  @@index([documentType, isActive, priority])
  @@index([variantId])
  @@index([contentBlockId])
  @@map("search_documents")
}

model AnalyticsSnapshot {
  id          String   @id @db.Uuid
  reportKey   String   @map("report_key")
  windowFrom  DateTime? @map("window_from")
  windowTo    DateTime? @map("window_to")
  payload     Json
  refreshedAt DateTime @map("refreshed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([reportKey, windowFrom, windowTo])
  @@map("analytics_snapshots")
}

enum StockMovementType {
  reservation
  release
  commit
  adjustment
  return
}

enum OrderStatus {
  draft
  pending_payment
  paid
  packed
  shipped
  delivered
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  approved
  rejected
  expired
  refunded
}

enum PromotionType {
  percentage
  fixed_amount
}

enum PromotionScope {
  line
  cart
}

enum PromotionStackingMode {
  exclusive
  stackable_same_scope
  stackable_cross_scope
}

enum PromotionTargetType {
  all
  product
  variant
  category
  brand
}

enum ContentType {
  banner
  hero
  text_section
  featured_brand
}

enum NotificationChannel {
  email
  whatsapp
  internal
}

enum NotificationStatus {
  queued
  sent
  failed
}

enum SearchDocumentType {
  variant
  content
}

{
  "name": "distritoolsjl-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend base enterprise de DistriTools JL con Next.js App Router.",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build && node ../scripts/generate-storefront-route-registry.js --check-manifest",
    "start": "next start --port 3001",

NODE_ENV=development
PORT=3000
APP_NAME=DistriTools JL Backend
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/distritoolsjl?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_2FA_CHALLENGE_SECRET=change-me-2fa-challenge
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_2FA_CHALLENGE_TTL=10m

# Initial admin bootstrap. Keep real values in local/runtime env only.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_REQUIRE_PASSWORD_CHANGE=true
ADMIN_BOOTSTRAP_REQUIRE_2FA=false
ADMIN_BOOTSTRAP_TOTP_SECRET=
ADMIN_RESET_EMAIL=
ADMIN_RESET_PASSWORD=
ADMIN_RESET_TOTP_SECRET=

# Checkout/payment providers. Keep secrets only in backend runtime env.
PAYMENT_PROVIDER=none
PAYMENT_PSE_PROVIDER=none
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
PAYU_API_KEY=
PAYU_API_LOGIN=
PAYU_MERCHANT_ID=
PAYU_ACCOUNT_ID=
CHECKOUT_IDEMPOTENCY_TTL_SECONDS=86400

# Frontend-safe feature flag. Does not contain secrets.
NEXT_PUBLIC_PSE_ENABLED=false

# Shipping providers. Do not invent guide or route numbers when provider=none.
SHIPPING_PROVIDER=internal
COORDINADORA_API_BASE_URL=
COORDINADORA_CLIENT_ID=
COORDINADORA_CLIENT_SECRET=
SERVIENTREGA_API_BASE_URL=
SERVIENTREGA_CLIENT_KEY=
SERVIENTREGA_CLIENT_SECRET=
NINETY_NINE_ENVIOS_API_BASE_URL=https://integration.99envios.app
NINETY_NINE_ENVIOS_AUTH_EMAIL=
NINETY_NINE_ENVIOS_AUTH_PASSWORD=
NINETY_NINE_ENVIOS_INTEGRATION_TOKEN=
NINETY_NINE_ENVIOS_INTEGRATION_ID=
NINETY_NINE_ENVIOS_ENV=sandbox
NINETY_NINE_ENVIOS_DEFAULT_BRANCH_CODE=
NINETY_NINE_ENVIOS_DEFAULT_ORIGIN_DANE_CODE=
NINETY_NINE_ENVIOS_DEFAULT_PDF_TYPE=2
NINETY_NINE_ENVIOS_ENABLE_COD=false
NINETY_NINE_ENVIOS_DEFAULT_SEGURO99=false
NINETY_NINE_ENVIOS_DEFAULT_SEGURO99PLUS=false

# Auto-shipping post-checkout (failsafe; disabled by default)
AUTO_SHIPPING_ENABLED=false
AUTO_SHIPPING_MODE=disabled
AUTO_SHIPPING_SELECT_STRATEGY=cheapest_successful
AUTO_SHIPPING_FAILSAFE=true
AUTO_SHIPPING_REQUIRE_DANE=true
AUTO_SHIPPING_REQUIRE_DIMENSIONS=true
AUTO_SHIPPING_CREATE_LABEL_AFTER_GUIDE=false
AUTO_SHIPPING_NOTIFY_ADMIN=true
AUTO_SHIPPING_NOTIFY_CUSTOMER=false
AUTO_SHIPPING_DEFAULT_DESTINATION_DANE_CODE=
AUTO_SHIPPING_DEFAULT_DESTINATION_DEPARTMENT=Valle del Cauca
AUTO_SHIPPING_DEFAULT_WEIGHT_KG=
AUTO_SHIPPING_DEFAULT_LENGTH_CM=
AUTO_SHIPPING_DEFAULT_WIDTH_CM=
AUTO_SHIPPING_DEFAULT_HEIGHT_CM=

# Local-only convenience. Never enable in production.
ADMIN_AUTH_DISABLED=false
